# Copie para .env.local e preencha. Sem nada preenchido, o site roda em modo de demonstração
# no desenvolvimento (npm run dev).

# Endereço usado nos links dos e-mails.
SITE_URL=http://localhost:3000

# 1 liga o modo de demonstração também em produção (pagamento simulado e /demo/emails).
# Nunca ligue no site público: qualquer pessoa confirma o próprio pagamento.
COLAJA_DEMO=

# E-mails com acesso a /admin, separados por vírgula.
ADMIN_EMAILS=

# Segredo que protege os códigos de login. Qualquer texto longo e aleatório.
AUTH_SECRET=

# PostgreSQL. Vazio = banco local embutido em .data/ (só para desenvolvimento).
DATABASE_URL=

# Supabase. Use a connection string do banco em DATABASE_URL (acima). Com as duas variáveis
# abaixo, as fotos de documento dos produtores vão para um bucket privado do Supabase Storage
# chamado "documentos" (criado sozinho no primeiro envio). A chave de serviço é secreta:
# nunca vai para o navegador nem para o git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Envio de e-mail pelo Resend.
RESEND_API_KEY=
MAIL_FROM=

# Assinatura dos avisos do gateway de pagamento.
PAYMENT_WEBHOOK_SECRET=
